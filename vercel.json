{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run db:migrate && npm run build",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.next,node_modules,src,tests,drizzle,scripts,docs,.data}/**"
    }
  },
  "rewrites": [{ "source": "/api/py/(.*)", "destination": "/api/index" }]
}
