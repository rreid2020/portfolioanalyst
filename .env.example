AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key_here

# Optional: "Connect brokerage" (SnapTrade). Leave unset to hide the feature.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# commercial (default): one SnapTrade user per browser session
# personal: your own SnapTrade account; every visitor sees its holdings
SNAPTRADE_KEY_TYPE=commercial

# Sign-in (Clerk OAuth application in ProjectCost's instance). Leave unset locally
# to run as a single local user; the deployed app requires them.
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=
CLERK_ISSUER_URL=
APP_URL=http://localhost:8501
# Saved portfolios: Neon sets this on Vercel; unset locally uses .data/portfolios.db
DATABASE_URL=
